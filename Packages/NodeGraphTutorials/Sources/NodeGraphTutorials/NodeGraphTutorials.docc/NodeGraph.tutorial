@Tutorials(name: "NodeGraph") {
    @Intro(title: "Build, run and extend node graphs") {
        Learn the NodeGraph packages by building with them, from an empty graph to your own node pack.
    }

    @Chapter(name: "Build a graph") {
        @Image(source: "chapter-build.svg", alt: "Two blue nodes linked to a green node.")

        Create, run, edit and save a graph with the Core package. No user interface is needed.

        @TutorialReference(tutorial: "doc:CreateAGraph")
        @TutorialReference(tutorial: "doc:RunAGraph")
        @TutorialReference(tutorial: "doc:UndoAndRedo")
        @TutorialReference(tutorial: "doc:SaveAndLoad")
    }

    @Chapter(name: "Show it") {
        @Image(source: "run-result.png", alt: "Two number nodes and an Add node after a run, each with a green check.")

        Put a graph on screen with SwiftUI, add the editing panels, run it, and organise it with groups and subgraphs.

        @TutorialReference(tutorial: "doc:ShowAGraph")
        @TutorialReference(tutorial: "doc:AddControls")
        @TutorialReference(tutorial: "doc:RunAndInspect")
        @TutorialReference(tutorial: "doc:GroupsAndSubgraphs")
    }

    @Chapter(name: "Write a node pack") {
        @Image(source: "chapter-pack.svg", alt: "Three orange nodes inside a dashed box, which stands for a package.")

        Add your own port types and nodes in a separate Swift package, and use it beside the built-in nodes.

        @TutorialReference(tutorial: "doc:DefineAPortType")
        @TutorialReference(tutorial: "doc:WriteTheNodes")
        @TutorialReference(tutorial: "doc:MakeItUsable")
        @TutorialReference(tutorial: "doc:ShipAPack")
    }
}
